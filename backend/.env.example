# ==========================================
# 财经日报系统配置文件示例
# 复制此文件为 .env 并填入你的配置
# ==========================================

# -------------------------------------------
# 👤 用户个性化配置（强烈建议配置）
# -------------------------------------------

# 用户昵称（播客中会用这个称呼你）
USER_NICKNAME=卢卡

# 投资风格（影响分析角度和建议激进程度）
# conservative = 保守型（偏好低风险、稳健收益）
# balanced = 平衡型（风险收益均衡）
# aggressive = 激进型（追求高收益，能承受波动）
INVESTMENT_STYLE=balanced

# 自选股列表（会在每日报告中特别追踪分析！）
# 格式: 代码:名称:市场（多个用逗号分隔）
# 市场: A=A股, HK=港股
# 
# 示例：追踪茅台、腾讯、宁德时代
# WATCHLIST_STOCKS=600519:贵州茅台:A,00700:腾讯控股:HK,300750:宁德时代:A
#
# 更多示例：
# 科技股组合：300750:宁德时代:A,002594:比亚迪:A,00700:腾讯控股:HK
# 消费股组合：600519:贵州茅台:A,000858:五粮液:A,600887:伊利股份:A
# 港股组合：00700:腾讯控股:HK,09988:阿里巴巴:HK,03690:美团:HK
WATCHLIST_STOCKS=

# 模型路由：现有OPENAI_API_KEY、OPENAI_BASE_URL仍有效。
# DeepSeek升级配置（请配置真实密钥；此处不包含密钥）
AI_PROVIDER=compatible
OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=在本地或服务器安全配置
ANALYSIS_MODEL=deepseek-v4-pro
ANALYSIS_REASONING_EFFORT=high
REVIEW_MODEL=deepseek-v4-pro
REVIEW_REASONING_EFFORT=high
EXTRACTION_MODEL=deepseek-flash
EXTRACTION_REASONING_EFFORT=none
PODCAST_MODEL=deepseek-flash
PODCAST_REASONING_EFFORT=none
AI_TIMEOUT_SECONDS=240

# 如需跨服务商核验，显式配置备用，不自动降级：
# REVIEW_PROVIDER=backup
# REVIEW_MODEL=该服务商实际支持的模型名
# REVIEW_REASONING_EFFORT=none
# BACKUP_AI_API_KEY=安全配置
# BACKUP_AI_BASE_URL=https://你的服务地址/v1
# BACKUP_AI_MODEL=明确模型名称
# 旧AI_MODEL仍可作为未配置阶段的兼容回退；不再猜测默认型号。

# -------------------------------------------
# 📊 股票数据配置（可选）
# -------------------------------------------

# Tushare Token（可选，AKShare 已经够用）
# TUSHARE_TOKEN=your_token_here

# -------------------------------------------
# ⏰ 定时任务配置
# -------------------------------------------

# 每日报告推送时间（24小时制）
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0

# 新闻采集提前时间（分钟）
COLLECTION_LEAD_TIME=60

# -------------------------------------------
# 🎙️ 语音合成配置（播客功能）
# -------------------------------------------

# TTS 语音角色
# 可选：zh-CN-YunxiNeural（男声）、zh-CN-XiaoxiaoNeural（女声）
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# -------------------------------------------
# ⚙️ 服务器配置
# -------------------------------------------

DEBUG=true
HOST=0.0.0.0
PORT=8000

# 通用搜索：需另行配置并明确启用，不复用模型密钥，不自动开通/付费。
# 返回搜索目录后还需读取公开正文；basic查询固定，不允许自动升级搜索深度。
RESEARCH_WEB_SEARCH_ENABLED=false
RESEARCH_WEB_SEARCH_API_KEY=
RESEARCH_WEB_SEARCH_MAX_REQUESTS=24

# 主动取材：当前额度按7个研究范围和App实际自选股数量分配；以下是硬上限。
# 保持默认关闭；配置额度或运行免费预览不会启用搜索、解除模型维护暂停。
RESEARCH_BODY_MAX_URLS=64
RESEARCH_INPUT_MAX_CHARACTERS=160000
RESEARCH_LOCAL_READ_MAX_CHARACTERS=96000
RESEARCH_MAX_SECONDS=900
# 报告阶段独立保留8次；新主动取材不从这里扣次数。旧流程仍按原整期口径。
MODEL_MAX_CALLS_PER_REPORT=8
# 取材默认不设固定模型次数；累计用量、时长和无进展止损始终有效。
# RESEARCH_MAX_MODEL_CALLS=如需额外紧急次数上限请填写正整数；不配置则没有固定次数上限
RESEARCH_TOTAL_INPUT_CHARACTERS=2000000
RESEARCH_TOTAL_OUTPUT_TOKENS=120000
# RESEARCH_REPORT_MODEL_RESERVE已停用，不再据此限制取材轮次。
# Unified edition: leave disabled until offline acceptance and explicit pricing.
# Existing model names, credentials and maintenance pause are NOT replaced.
EDITION_ESTIMATE_ACCEPTED=false
# EDITION_ESTIMATED_LIMIT_USD=<accepted per-edition estimate in USD>
# EDITION_SEARCH_PRICE_USD=<reviewed per-search USD estimate>
# EDITION_PRICE_TABLE={"provider/model":{"input":0,"output":0,"cache_read":0,"cache_write":0}}
# Replace all four illustrative zero rates with reviewed per-million-token prices.
# EDITION_AUDIO_ENABLED=true

