# Existing deployment profile confirmed by the user's server configuration.
# Merge these non-secret settings into the existing .env; do not replace it.
# Keep OPENAI_API_KEY, BACKUP_AI_API_KEY and BACKUP_AI_BASE_URL.
# User's production server can reach this official mirror; api.ofox.ai fails
# to connect there. Verify authenticated access before applying on the server.
OPENAI_BASE_URL=https://api.ofox.io/v1
AI_PROVIDER=compatible
AI_MODEL=anthropic/claude-sonnet-5.5
ANALYSIS_PROVIDER=compatible
ANALYSIS_MODEL=anthropic/claude-sonnet-5.5
ANALYSIS_REASONING_EFFORT=none
REVIEW_PROVIDER=compatible
REVIEW_MODEL=anthropic/claude-sonnet-5.5
REVIEW_REASONING_EFFORT=none
EXTRACTION_PROVIDER=compatible
EXTRACTION_MODEL=deepseek/deepseek-v4.1-flash
EXTRACTION_REASONING_EFFORT=none
PODCAST_PROVIDER=compatible
PODCAST_MODEL=deepseek/deepseek-v4.1-flash
PODCAST_REASONING_EFFORT=none
BACKUP_AI_MODEL=deepseek-ai/DeepSeek-V3
# Claude uses /anthropic/v1/messages; extraction/editing use /v1/chat/completions.
# This profile requires the upgraded model_gateway; do not apply to old server code.
# First establish a working baseline. Cheaper extraction/editing or an independent
# reviewer must be selected from this account's available models and evaluated.
# The backup is not selected silently for financial analysis or verification.
